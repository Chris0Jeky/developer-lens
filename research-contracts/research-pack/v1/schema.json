            "pattern": "^(?!.*(?:person|productiv|performance|effort|attendance|hours[_-]?worked|availability|diligence|quality|worth|personality|sentiment|burnout|surveillance|bus[_-]?factor|individual[_-]?output))[A-Za-z][A-Za-z0-9_.-]{0,95}$",
            "type": "string"
          },
          "prohibited_interpretation_codes": {
            "items": {
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$",
              "type": "string"
            },
            "maxItems": 12,
            "minItems": 1,
            "type": "array"
