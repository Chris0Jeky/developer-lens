# Optional, semicolon-separated roots. Developer Lens never scans local repos
# unless you list them explicitly.
DEV_LENS_LOCAL_ROOTS=C:\path\to\repos;D:\another\explicit\root

# Optional, semicolon-separated author email aliases for local Git attribution.
# Name matching is intentionally not used because collaborators can share names.
DEV_LENS_GIT_EMAILS=you@example.com;12345+you@users.noreply.github.com

# The local API binds to 127.0.0.1 only.
DEVELOPER_LENS_PORT=4141
