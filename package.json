{
  "name": "developer-lens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "collect": "tsx scripts/collect.ts",
    "analyze": "tsx scripts/analyze.ts",
    "export:demo": "tsx scripts/exportDemo.ts",
    "render:social": "tsx scripts/renderSocialCard.ts",
    "build": "tsc -b && vite build",
    "build:showcase": "npm run export:demo && npm run render:social && tsc -b && vite build --base=/developer-lens/ --mode showcase && npm run verify:showcase",
    "start": "tsx server/index.ts --production",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:showcase": "tsx scripts/verifyShowcase.ts",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
